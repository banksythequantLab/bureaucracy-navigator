# Copy to .env — never commit .env
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1/
# IDs verified against the Token Factory /models listing on 2026-09-17
NEBIUS_REASONING_MODEL=nvidia/nemotron-3-super-120b-a12b
NEBIUS_FAST_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B

# Optional: without a key tavily-python runs in rate-limited keyless mode
TAVILY_API_KEY=

# Optional: Deadline Sentinel email (runner prints instead when unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

BN_CACHE_DIR=.cache/rules
BN_RULES_TTL_SECONDS=86400
BN_SESSION_DIR=.cache/sessions
BN_CASE_DIR=.cache/cases
